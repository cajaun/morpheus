{
  "name": "morpheus",
  "version": "1.0.0",
  "description": "A production-grade morphing action tray for React Native.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cajaun/morpheus.git"
  },
  "bugs": {
    "url": "https://github.com/cajaun/morpheus/issues"
  },
  "homepage": "https://github.com/cajaun/morpheus#readme",
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/src/index.d.ts",
      "react-native": "./src/index.ts",
      "source": "./src/index.ts",
      "import": "./lib/module/index.js",
      "default": "./lib/module/index.js"
    },
    "./constants": {
      "types": "./lib/typescript/src/constants.d.ts",
      "react-native": "./src/constants.ts",
      "source": "./src/constants.ts",
      "import": "./lib/module/constants.js",
      "default": "./lib/module/constants.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "!src/**/__fixtures__",
    "!src/**/__mocks__",
    "!src/**/__tests__",
    "!src/**/*.test.*",
    "!src/**/*.qa.test.*"
  ],
  "sideEffects": false,
  "scripts": {
    "start": "npm run start --workspace morpheus-example",
    "android": "npm run android --workspace morpheus-example",
    "ios": "npm run ios --workspace morpheus-example",
    "web": "npm run web --workspace morpheus-example",
    "build": "bob build",
    "prepare": "bob build",
    "test": "jest --watch",
    "test:ci": "jest --runInBand --watchman=false",
    "test:coverage": "jest --runInBand --watchman=false --coverage",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace morpheus-example",
    "lint": "eslint src --ext .ts,.tsx && npm run lint --workspace morpheus-example",
    "quality": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run pack:check",
    "pack:check": "node scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "expo-haptics": ">=14.0.0",
    "react": ">=18.2.0",
    "react-native": ">=0.76.0",
    "react-native-gesture-handler": ">=2.20.0",
    "react-native-keyboard-controller": ">=1.18.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-safe-area-context": ">=4.10.0",
    "react-native-worklets": ">=0.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~10.0.0",
    "expo": "^54.0.33",
    "expo-haptics": "~15.0.8",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.17",
    "react": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-builder-bob": "^0.43.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "^1.21.6",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-worklets": "0.5.1",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2",
    "uniwind": "^1.6.2"
  },
  "workspaces": [
    "example"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "**/{__tests__,__fixtures__,__mocks__}/**",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "keywords": [
    "react-native",
    "expo",
    "action-tray",
    "bottom-sheet",
    "animation",
    "reanimated"
  ],
  "dependencies": {
    "expo": "~54.0.33",
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
